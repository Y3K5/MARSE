{
  "schema_version": 2,
  "description": "Two bacteria share glucose in a closed, well-mixed box. An aerobic heterotroph respires it; a lactic fermenter ferments it, and the heterotroph also grows on the fermenter's lactate while oxygen lasts. Apart from the yields, every coefficient is derived from the carbon, nitrogen and electron balances. Yields, rates and half-saturation constants are illustrative (confidence C), not measurements.",
  "components": [
    {"name": "glucose", "phase": "dissolved", "formula": "C6H12O6"},
    {"name": "oxygen", "phase": "dissolved", "formula": "O2"},
    {"name": "ammonium", "phase": "dissolved", "formula": "NH4", "charge": 1},
    {"name": "carbon_dioxide", "phase": "dissolved", "formula": "CO2"},
    {"name": "lactate", "phase": "dissolved", "formula": "C3H5O3", "charge": -1},
    {"name": "heterotroph", "phase": "particulate", "formula": "CH1.8O0.5N0.2"},
    {"name": "fermenter", "phase": "particulate", "formula": "CH1.8O0.5N0.2"}
  ],
  "processes": [
    {
      "name": "heterotroph_growth_on_glucose",
      "kind": "growth",
      "biomass": "heterotroph",
      "substrate": "glucose",
      "yield_mol_per_mol": 3.6,
      "balanced_by": ["oxygen", "carbon_dioxide", "ammonium"],
      "rate": {
        "maximum_per_h": 0.4,
        "factors": [
          {"component": "glucose", "form": "monod", "half_saturation_mol_per_m3": 0.05},
          {"component": "oxygen", "form": "monod", "half_saturation_mol_per_m3": 0.005},
          {"component": "ammonium", "form": "monod", "half_saturation_mol_per_m3": 0.01}
        ]
      }
    },
    {
      "name": "fermenter_growth_on_glucose",
      "kind": "growth",
      "biomass": "fermenter",
      "substrate": "glucose",
      "yield_mol_per_mol": 0.6,
      "balanced_by": ["lactate", "carbon_dioxide", "ammonium"],
      "rate": {
        "maximum_per_h": 0.3,
        "factors": [
          {"component": "glucose", "form": "monod", "half_saturation_mol_per_m3": 0.1},
          {"component": "ammonium", "form": "monod", "half_saturation_mol_per_m3": 0.01}
        ]
      }
    },
    {
      "name": "heterotroph_growth_on_lactate",
      "kind": "growth",
      "biomass": "heterotroph",
      "substrate": "lactate",
      "yield_mol_per_mol": 1.5,
      "balanced_by": ["oxygen", "carbon_dioxide", "ammonium"],
      "rate": {
        "maximum_per_h": 0.3,
        "factors": [
          {"component": "lactate", "form": "monod", "half_saturation_mol_per_m3": 0.1},
          {"component": "oxygen", "form": "monod", "half_saturation_mol_per_m3": 0.005},
          {"component": "ammonium", "form": "monod", "half_saturation_mol_per_m3": 0.01}
        ]
      }
    },
    {
      "name": "heterotroph_endogenous_respiration",
      "kind": "reaction",
      "stoichiometry_mol_per_mol": {
        "heterotroph": -1
      },
      "balanced_by": ["oxygen", "carbon_dioxide", "ammonium"],
      "rate": {
        "maximum_per_h": 0.01,
        "proportional_to": "heterotroph",
        "factors": [
          {"component": "oxygen", "form": "monod", "half_saturation_mol_per_m3": 0.005}
        ]
      }
    }
  ],
  "experiment_id": "glucose-cross-feeding",
  "initial_mol_per_m3": {
    "glucose": 20.0,
    "oxygen": 0.25,
    "ammonium": 10.0,
    "heterotroph": 0.01,
    "fermenter": 0.01
  },
  "duration_h": 48.0,
  "timestep_h": 0.5,
  "record_interval_h": 0.5
}
